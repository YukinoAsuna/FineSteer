# Required. Accepted values:
# - alias: llama3.1 or qwen2.5
# - Hugging Face ID: meta-llama/Llama-3.1-8B-Instruct
# - local checkpoint directory: /data/models/Llama-3.1-8B-Instruct
FINESTEER_MODEL=llama3.1

# Optional defaults.
FINESTEER_MODEL_KEY=llama31
FINESTEER_METHOD=MoSE
# Alternative: orthogonal_residual
FINESTEER_DEVICE=cuda:0
FINESTEER_LAYER=12
FINESTEER_STRENGTH=2.5
FINESTEER_LIMIT=0
FINESTEER_LOCAL_FILES_ONLY=false

# Only needed by finesteer-evaluate. Never commit a real key.
OPENAI_API_KEY=
